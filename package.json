{
  "name": "metronome-app",
  "version": "0.0.1",
  "description": "a web browser metronome",
  "repository": "https://github.com/clhenrick/metronome-app",
  "author": "Chris Henrick <chrishenrick@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:gh-pages": "yarn build && . ./deploy_gh_pages.sh",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier-eslint --write \"src/**/*.{ts,tsx,scss}\""
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.5.1",
    "@vitest/coverage-v8": "^3.1.3",
    "eslint": "^4.14.0",
    "eslint-config-airbnb": "^16.1.0",
    "eslint-config-prettier": "^2.9.0",
    "eslint-plugin-babel": "^4.1.2",
    "eslint-plugin-import": "^2.8.0",
    "eslint-plugin-jsx-a11y": "^6.0.3",
    "eslint-plugin-prettier": "^2.4.0",
    "eslint-plugin-react": "^7.5.1",
    "jsdom": "^26.1.0",
    "prettier": "^1.9.2",
    "prettier-eslint": "^8.7.0",
    "prettier-eslint-cli": "^4.7.1",
    "sass": "^1.87.0",
    "typescript": "^6.0.3",
    "vite": "^6.3.4",
    "vitest": "^3.1.3"
  },
  "dependencies": {
    "normalize.css": "^8.0.1",
    "react": "^18",
    "react-dom": "^18",
    "skeleton-scss": "^2.0.4"
  },
  "packageManager": "yarn@4.14.1"
}
