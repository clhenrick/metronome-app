{
  "name": "metronome-app",
  "version": "0.0.1",
  "description": "a web browser metronome",
  "repository": "https://github.com/clhenrick/metronome-app",
  "author": "Chris Henrick <chrishenrick@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:gh-pages": "yarn build && . ./deploy_gh_pages.sh",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\" \"tests/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.5.1",
    "@vitest/coverage-v8": "^3.1.3",
    "@vitest/eslint-plugin": "^1.1.44",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "sass": "^1.87.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.4",
    "vitest": "^3.1.3"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.10",
    "react": "^18",
    "react-dom": "^18"
  },
  "packageManager": "yarn@4.14.1"
}
